# Workers static assets: response headers by path.
# Vite fingerprints everything in /assets/ (index-CcDaQU7x.js), so a file there never
# changes: browsers may keep it for a year without asking again. index.html keeps the
# default (always revalidate), so a new deploy is picked up on the next visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

# the site's own link-preview card (a shared notice uses /og/<id>.jpg instead)
/og-default.jpg
  Cache-Control: public, max-age=86400
