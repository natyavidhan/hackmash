# ~/.config/hackmash/sync.env (chmod 600): read by hackmash-sync.service
# The same value as the Worker's INGEST_KEY secret (wrangler secret put INGEST_KEY).
HACKMASH_INGEST_KEY=
# The site to update.
HACKMASH_API=https://hackmash.xyz
# Where the job keeps its state (first-seen dates, extensions, platform health).
HACKMASH_DATA_DIR=/home/YOU/.local/share/hackmash
